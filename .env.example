# Copia este archivo como .env y ajústalo. El .env NUNCA se sube a git.

# --- Nombre del asistente ---
# Cómo se llama y cómo se refiere a sí mismo. Puedes ponerle el que quieras.
JARVIS_NOMBRE=Jarvis
JARVIS_IDIOMA=español

# --- Palabra de activación ---
# OJO: esto NO es libre. Cada palabra es un modelo entrenado con miles de
# grabaciones de esa frase concreta, así que solo se puede usar una de estas:
#
#   hey_jarvis     -> "hey Jarvis"
#   alexa          -> "Alexa"
#   hey_mycroft    -> "hey Mycroft"
#   hey_rhasspy    -> "hey Rhasspy"
#
# Son en inglés, así que se pronuncian como en inglés aunque luego le hables
# en español. Puedes llamarlo "Paco" y activarlo diciendo "Alexa": el nombre
# del asistente y la palabra que lo despierta son cosas independientes.
#
# Para una palabra propia hay que entrenar un modelo (openWakeWord explica
# cómo) y poner aquí la ruta a tu archivo .onnx.
JARVIS_PALABRA_CLAVE=hey_jarvis

# --- Modelo local (obligatorio) ---
# Lo que uses en Ollama. qwen3:8b es el equilibrio recomendado.
JARVIS_MODELO_LOCAL=qwen3:8b
JARVIS_OLLAMA_URL=http://localhost:11434
# Por seguridad solo se acepta un Ollama de este equipo (localhost). Si tienes
# uno en otro ordenador de tu red, pon 1 aquí: tus conversaciones viajarán sin
# cifrar hasta él.
# JARVIS_PERMITIR_OLLAMA_REMOTO=1

# Cuánto mantiene Ollama el modelo en memoria sin usarlo. Bajarlo libera RAM
# pero hace que la siguiente pregunta tarde mucho más.
JARVIS_KEEP_ALIVE=30m

# Contexto del modelo local, en tokens. El prompt de Jarvis ya ocupa unos 4600:
# por debajo de 8192 Ollama recorta sus instrucciones sin avisar.
# JARVIS_CONTEXTO=8192

# --- Voz ---
# Segundos de silencio que indican que has terminado de hablar. Menos es más
# rápido; si Jarvis te corta a media frase cuando haces una pausa, súbelo.
# JARVIS_SILENCIO_FIN_DE_FRASE=0.8

# Voz de Piper. Para probar otra, descárgala primero:
#   python -m voice.habla descargar es_ES-sharvard-medium
# JARVIS_VOZ_PIPER=es_ES-davefx-medium

# Decir "hey Jarvis" mientras habla lo interrumpe y te escucha. Solo funciona si
# has registrado tu voz (para que no se corte a sí mismo). 0 lo desactiva.
# JARVIS_INTERRUMPIR=1

# --- Claude, opcional ---
# Sin clave funciona igual: todo se queda en local. Con clave, las tareas
# complejas se derivan a un modelo más capaz por unos céntimos al mes.
# Se obtiene en https://console.anthropic.com
ANTHROPIC_API_KEY=
JARVIS_MODELO_CLAUDE=claude-sonnet-5
